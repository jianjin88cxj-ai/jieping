<Window x:Class="Jieping.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Jieping"
        Icon="Assets/AppIcon.ico"
        Height="720"
        Width="1080"
        MinHeight="720"
        MinWidth="1080"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#E9EEF5"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#E9EEF5" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7DEE8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6676" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7B8794" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#A4AFBD" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D2DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3F6FA" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9DAABE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E7ECF3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#F6F8FB" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#DDE3EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#F2B6B6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D2DF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C9D2DF" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource PageBackgroundBrush}">
    <Grid x:Name="FullLayout" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Jieping"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [AppSubtitle]}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Language]}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CanChangeTarget}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding [RecordingMode]}" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3">
                            <Button Content="{Binding [Region]}" Command="{Binding SelectModeCommand}" CommandParameter="Region" />
                            <Button Content="{Binding [Window]}" Command="{Binding SelectModeCommand}" CommandParameter="Window" />
                            <Button Content="{Binding [FullScreen]}" Command="{Binding SelectModeCommand}" CommandParameter="FullScreen" Margin="0" />
                        </UniformGrid>

                        <Border Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [CurrentTarget]}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TargetSummary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [State]}" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Elapsed]}" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ElapsedTime}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Margin="0,18,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding [Status]}" Style="{StaticResource SectionTitle}" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxHeight="56" />
                            <TextBlock Text="{Binding LastOutputPath, TargetNullValue=''}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="38"
                                       Margin="0,12,0,0" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="{Binding [OpenFile]}" Command="{Binding OpenLastFileCommand}" />
                                <Button Content="{Binding [OpenFolder]}" Command="{Binding OpenLastFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Row="2"
                                Content="{Binding [SelectTarget]}"
                                Command="{Binding SelectTargetCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,16,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [VideoSettings]}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding [Preset]}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Width="270" HorizontalAlignment="Left" ItemsSource="{Binding RecordingPresetOptions}" SelectedItem="{Binding SelectedRecordingPresetOption}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeTarget}" />
                            <TextBlock Grid.Row="1" Text="{Binding [FrameRate]}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,14,0,0" ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding FrameRate}" IsEnabled="{Binding CanChangeTarget}" />
                            <TextBlock Grid.Row="2" Text="{Binding [Quality]}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,14,0,0" ItemsSource="{Binding QualityDisplayOptions}" SelectedItem="{Binding SelectedQualityOption}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeTarget}" />
                            <TextBlock Grid.Row="3" Text="{Binding [Bitrate]}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,14,0,0" ItemsSource="{Binding VideoBitrateDisplayOptions}" SelectedItem="{Binding SelectedVideoBitrateOption}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeTarget}" />
                            <TextBlock Grid.Row="4" Text="{Binding [Display]}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="0,14,0,0" ItemsSource="{Binding DisplayOptions}" SelectedItem="{Binding SelectedDisplayOption}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectDisplay}" />
                            <TextBlock Grid.Row="5" Text="{Binding [SaveTo]}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0" />
                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                    <TextBlock Text="{Binding OutputDirectory}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1" Content="{Binding [Browse]}" Command="{Binding BrowseOutputDirectoryCommand}" Margin="10,0,0,0" />
                            </Grid>
                        </Grid>

                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding [Audio]}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <CheckBox Content="{Binding [RecordSystemAudio]}" IsChecked="{Binding CaptureSystemAudio}" IsEnabled="{Binding CanChangeTarget}" />
                                    <CheckBox Content="{Binding [RecordMicrophone]}" IsChecked="{Binding CaptureMicrophoneAudio}" IsEnabled="{Binding CanUseMicrophoneAudio}" />
                                    <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectMicrophoneDevice}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding [Pointer]}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <CheckBox Content="{Binding [RecordMouseCursor]}" IsChecked="{Binding CaptureCursor}" IsEnabled="{Binding CanChangeTarget}" />
                                    <CheckBox Content="{Binding [HighlightMouseClicks]}" IsChecked="{Binding HighlightMouseClicks}" IsEnabled="{Binding CanChangeTarget}" />
                                    <TextBlock Text="{Binding [Watermark]}" FontWeight="SemiBold" Margin="0,10,0,10" />
                                    <CheckBox Content="{Binding [AddTextWatermark]}" IsChecked="{Binding IncludeWatermark}" IsEnabled="{Binding CanChangeTarget}" />
                                    <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditWatermarkText}" Width="220" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding [PostProcessing]}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [TrimCopy]}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding [StartSeconds]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding TrimStartSeconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTrimLastOutput}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [EndSeconds]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding TrimEndSeconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTrimLastOutput}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Content="{Binding [SaveTrimmedCopy]}" Command="{Binding TrimLastOutputCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [GifExport]}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding [Fps]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding GifFrameRateOptions}" SelectedItem="{Binding GifFrameRate}" IsEnabled="{Binding CanExportGif}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Width]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding GifWidthOptions}" SelectedItem="{Binding GifWidth}" IsEnabled="{Binding CanExportGif}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <WrapPanel>
                                        <Button Content="{Binding [ExportGif]}" Command="{Binding ExportGifCommand}" />
                                        <Button Content="{Binding [OpenGif]}" Command="{Binding OpenLastGifCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding [RecordingHistory]}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding RecordingHistory.Count}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text=" " Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding [RecentItems]}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Content="{Binding [Clear]}" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="8,0,0,0" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding RecordingHistory}" MinHeight="96" MaxHeight="150" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="{StaticResource PanelAltBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Foreground="#5B6676" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CreatedAtDisplay, StringFormat={}{0}}" Foreground="#7B8794" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ArtifactType}" Foreground="#5B6676" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Content="{Binding DataContext[Open], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.OpenHistoryFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="{Binding DataContext[Folder], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding [Updates]}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding [Current]}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding [Manifest]}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UpdateManifestLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0" />
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{Binding [CheckForUpdates]}" Command="{Binding CheckForUpdatesCommand}" />
                            <Button Content="{Binding [DownloadUpdate]}" Command="{Binding DownloadUpdatePackageCommand}" />
                            <Button Content="{Binding [OpenDownloadedPackage]}" Command="{Binding OpenDownloadedUpdatePackageCommand}" />
                            <Button Content="{Binding [OpenDownloadPage]}" Command="{Binding OpenUpdatePackageCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding DownloadedUpdatePackagePath, TargetNullValue=''}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding [Diagnostics]}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                        <CheckBox Content="{Binding [SaveCrashReportsLocally]}" IsChecked="{Binding AllowCrashReports}" />
                        <TextBlock Text="{Binding [CrashReportsHelp]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                            <TextBlock Text="{Binding CrashReportDirectory}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Button Content="{Binding [OpenCrashReportsFolder]}" Command="{Binding OpenCrashReportFolderCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding DiagnosticsStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding [StartRecording]}"
                            Command="{Binding StartRecordingCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="{Binding PauseResumeLabel}"
                            Command="{Binding PauseResumeCommand}"
                            MinWidth="96" />
                    <Button Content="{Binding StopRecordingLabel}"
                            Command="{Binding StopRecordingCommand}"
                            Style="{StaticResource DangerButton}"
                            MinWidth="96"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <Border x:Name="MiniLayout"
            Visibility="Collapsed"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Jieping"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="#EAF2FF"
                            BorderBrush="#BFD2FF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding StateLabel}"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding TargetSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <Border Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding ElapsedTime}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <Button Content="{Binding PauseResumeLabel}"
                        Command="{Binding PauseResumeCommand}"
                        MinWidth="84" />
                <Button Content="{Binding StopRecordingLabel}"
                        Command="{Binding StopRecordingCommand}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="84"
                        Margin="0" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
