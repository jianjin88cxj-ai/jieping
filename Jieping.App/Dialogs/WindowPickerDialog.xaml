<Window x:Class="Jieping.App.Dialogs.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Window"
        Width="620"
        Height="420"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select a visible window" FontSize="18" FontWeight="SemiBold" />

        <ListView x:Name="WindowList"
                  Grid.Row="1"
                  Margin="0,14,0,14"
                  MouseDoubleClick="OnWindowListDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="340" />
                    <GridViewColumn Header="Process" DisplayMemberBinding="{Binding ProcessName}" Width="120" />
                    <GridViewColumn Header="Size" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Bounds.Description}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Refresh" MinWidth="86" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="Cancel" MinWidth="86" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Select" MinWidth="86" IsDefault="True" Click="OnSelectClick" />
        </StackPanel>
    </Grid>
</Window>
